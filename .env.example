NODE_ENV=development


# Database Configuration
DB_HOST=db
DB_PORT=5432
DB_NAME=alacarte
DB_USER=postgres
DB_PASSWORD=your_secure_password
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public
DIRECT_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Fee Configuration
PAYOUT_PERCENTAGE_FEE=0.05
PAYOUT_FIXED_FEE=15

# Xendit Configuration
XENDIT_API_KEY=your_xendit_api_key
XENDIT_SECRET_KEY=your_xendit_secret_key
XENDIT_WEBHOOK_SECRET=your_xendit_webhook_secret
NEXT_PUBLIC_XENDIT_PUBLIC_KEY=

# Email Configuration (AWS SES)
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
EMAIL_FROM=alacarte <no-reply@example.com>

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# JWT Configuration
JWT_SECRET=your_secure_jwt_secret


# Email configuration
EMAIL_FROM=alacart.store <alacart@memokitchen.com>
RESEND_API_KEY=

# DOMAIN
DOMAIN=localhost:3000 #for development, change in production

# File Upload Configuration
UPLOADS_DIR=/home/aryeh/dev/alacarte/uploads